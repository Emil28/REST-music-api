{
  "info": {
    "_postman_id": "7efbc68a-e29f-4d66-8b78-843a61f9d4db",
    "name": "DR Music Records API",
    "description": "Integration tests for authentication and music-record CRUD. Set baseUrl, username, and password in a Postman environment before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5209" },
    { "key": "username", "value": "" },
    { "key": "password", "value": "" },
    { "key": "token", "value": "" },
    { "key": "recordId", "value": "" },
    { "key": "recordTitle", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login returns 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.expect(body.token).to.be.a('string').and.not.empty;",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET records without JWT returns 401",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/musicRecords"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Protected endpoint returns 401 without a token', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET all records",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "url": "{{baseUrl}}/api/musicRecords"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET returns 200', function () { pm.response.to.have.status(200); });",
              "pm.expect(pm.response.json()).to.be.an('array');"
            ]
          }
        }
      ]
    },
    {
      "name": "POST create temporary record",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('recordTitle', `Postman test ${Date.now()}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('POST returns 201', function () { pm.response.to.have.status(201); });",
              "const record = pm.response.json();",
              "pm.expect(record.id).to.be.a('number');",
              "pm.collectionVariables.set('recordId', String(record.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{recordTitle}}\",\n  \"artist\": \"Postman Test Artist\",\n  \"duration\": 180,\n  \"publicationYear\": 2024\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/musicRecords"
      }
    },
    {
      "name": "GET record filtered by title",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "url": "{{baseUrl}}/api/musicRecords?title={{recordTitle}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Filtered GET returns 200', function () { pm.response.to.have.status(200); });",
              "const records = pm.response.json();",
              "pm.expect(records).to.have.lengthOf(1);",
              "pm.expect(String(records[0].id)).to.eql(pm.collectionVariables.get('recordId'));"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT update temporary record",
      "request": {
        "method": "PUT",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{recordTitle}} Updated\",\n  \"artist\": \"Updated Postman Test Artist\",\n  \"duration\": 240,\n  \"publicationYear\": 2025\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/musicRecords/{{recordId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('PUT returns 200', function () { pm.response.to.have.status(200); });",
              "pm.expect(pm.response.json().title).to.include('Updated');"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE temporary record",
      "request": {
        "method": "DELETE",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "url": "{{baseUrl}}/api/musicRecords/{{recordId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('DELETE returns 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    }
  ]
}
